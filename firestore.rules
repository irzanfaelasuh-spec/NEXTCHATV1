rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function self(uid){ return signedIn() && request.auth.uid == uid; }
    function member(cid){ return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if self(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','displayName','username','number','about','createdAt','photoURL'])
        && request.resource.data.displayName is string && request.resource.data.number is string;
      allow update: if self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','about','photoURL']);
      allow delete: if false;
      match /contacts/{contactUid} {
        allow read: if self(uid);
        allow create, update: if self(uid) && request.resource.data.uid == contactUid
          && request.resource.data.keys().hasOnly(['uid','displayName','number','lastMessage','createdAt']);
        allow delete: if self(uid);
      }
    }
    match /numbers/{number} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/numbers/$(number));
      allow update, delete: if false;
    }
    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      match /messages/{mid} {
        allow read: if member(cid);
        allow create: if member(cid) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['text','senderId','createdAt','deletedForEveryone','reactions','pinned'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow update: if member(cid) && (
          (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deletedForEveryone','deletedAt','pinned','reactions','hiddenFor']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions','hiddenFor','pinned'])
        );
        allow delete: if false;
      }
    }
    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid
        && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2 && request.resource.data.status == 'ringing';
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer','answer','status','acceptedAt','endedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
      match /candidates/{candidateUid}/items/{itemId} {
        allow read, create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
